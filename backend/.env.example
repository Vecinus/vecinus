# --- Configuración de Inteligencia Artificial (Gemini) ---
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# --- Configuración de Base de Datos principal (Supabase) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<anon-or-service-role-key>
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_SCHEMA=dev_s2

# --- Configuración de Base de Datos Vectorial (Pinecone) ---
PINECONE_API_KEY=tu_api_key_de_pinecone_aqui
PINECONE_INDEX_NAME=tu_nombre_de_indice_pinecone_aqui

# --- Configuración de Base de datos de imágenes (Cloudinary) ---
CLOUDINARY_URL=cloudinary://tu_api_key:tu_api_secret@tu_nube_de_cloudinary
# --- Configuración de Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# URL base del frontend (para generar links en emails)
APP_BASE_URL=https://tu-app.com

# --- Configuración de GoCardless (sandbox permanente) ---
GOCARDLESS_ACCESS_TOKEN=sandbox_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOCARDLESS_BASE_URL=https://api-sandbox.gocardless.com
GOCARDLESS_VERSION=2015-07-06
GOCARDLESS_SCHEME=sepa_core
GOCARDLESS_EXIT_URI=http://localhost:8081/payments/gocardless/cancel
GOCARDLESS_WEBHOOK_SECRET=
MULTICOMMUNITY_CURRENCY=EUR
REGISTRATION_PAYMENT_AMOUNT_CENTS=3000

# --- Plan Básico ---
BASIC_PLAN_BASE_CENTS=2000
BASIC_PLAN_PER_HOUSEHOLD_CENTS=20
BASIC_MINUTES_HOURS=2
BASIC_MINUTES_CARRYOVER_CAP_HOURS=10
BASIC_CHATBOT_BASE_MSG=500
BASIC_CHATBOT_PER_HOUSEHOLD_MSG=5

# --- Plan Premium ---
PREMIUM_PLAN_BASE_CENTS=3000
PREMIUM_PLAN_PER_HOUSEHOLD_CENTS=50
PREMIUM_MINUTES_HOURS=4
PREMIUM_MINUTES_CARRYOVER_CAP_HOURS=20
PREMIUM_CHATBOT_BASE_MSG=1000
PREMIUM_CHATBOT_PER_HOUSEHOLD_MSG=10

# --- Restricciones del chatbot ---
CHATBOT_INPUT_CHAR_LIMIT=300
CHATBOT_OUTPUT_CHAR_LIMIT=1000
